# Mock untuk demo lokal. Ganti OLT_MODE=zte setelah seluruh perintah diverifikasi.
OLT_MODE=mock
APP_USERNAME=admin
# Hash PBKDF2-HMAC-SHA256 salt:digest; buat dengan instruksi pada docs/INSTALASI_SERVER.md.
APP_PASSWORD_HASH=
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Buat dengan: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
DATABASE_PATH=./data/olt.db
ACCESS_TOKEN_MINUTES=480
OLT_HOST=127.0.0.1
OLT_PORT=23
OLT_USERNAME=
OLT_PASSWORD=
OLT_TIMEOUT=8
# Opsional, dipakai jika adapter OLT belum menyediakan daftar bandwidth profile.
BANDWIDTH_PROFILES=20M,50M,100M
