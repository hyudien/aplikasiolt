# Copy to .env (or export these variables) before running.
# Path of the local SQLite database (OLT settings + synced ONT cache).
OLT_APP_DB=./data/olt.db
# Telnet timeouts in seconds.
OLT_CONNECT_TIMEOUT=8
OLT_COMMAND_TIMEOUT=20
# Optional shared token; if set, clients must send "X-API-Token: <token>".
OLT_APP_TOKEN=
