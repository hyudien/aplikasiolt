[Unit]
Description=OLT Control API
After=network-online.target

[Service]
Type=simple
User=oltcontrol
WorkingDirectory=/opt/aplikasiolt/backend
EnvironmentFile=/opt/aplikasiolt/backend/.env
ExecStart=/opt/aplikasiolt/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
